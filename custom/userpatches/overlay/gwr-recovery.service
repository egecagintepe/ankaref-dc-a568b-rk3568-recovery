[Unit]
Description=Great Wall Recovery - DC_A568 eMMC recovery
# Runs independently of networking: NO Before=network-pre.target, so Ethernet/DHCP start in parallel.
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
Conflicts=shutdown.target
Before=shutdown.target
[Service]
# Type=exec: considered started immediately, so nothing (network, multi-user.target) waits for the
# 15+ minute recovery run to finish.
Type=exec
ExecStart=/usr/local/sbin/gwr-recovery.sh
TimeoutStartSec=0
[Install]
WantedBy=multi-user.target
